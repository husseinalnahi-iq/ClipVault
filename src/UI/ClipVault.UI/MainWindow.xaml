<Window x:Class="ClipVault.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:ClipVault.UI.ViewModels"
        mc:Ignorable="d"
        Title="ClipVault"
        Width="450"
        Height="650"
        MinWidth="400"
        MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text"
        Icon="pack://application:,,,/Assets/Clipboard2.png">
    <Window.Resources>
        <Style x:Key="ModernThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#374151" CornerRadius="10" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="{TemplateBinding Width}" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6" />
                    <Setter Property="Width" Value="Auto" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="HoverBlue" Color="#1E40AF" />
        <SolidColorBrush x:Key="PressedBlue" Color="#1E3A8A" />
        <SolidColorBrush x:Key="SubtleHoverBlueBg" Color="#1A1F3B" />
        <SolidColorBrush x:Key="SubtleHoverBlueBorder" Color="#2B4F9C" />
        <SolidColorBrush x:Key="SubtleHoverBlueText" Color="#DBEAFE" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SubtleHoverBlueBg}" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleHoverBlueText}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBlue}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1D23" />
            <Setter Property="BorderBrush" Value="#2E323A" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SubtleHoverBlueBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleHoverBlueText}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBlue}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBlue}" />
                    <Setter Property="BorderBrush" Value="{StaticResource HoverBlue}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBlue}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#5A2020" />
            <Setter Property="BorderBrush" Value="#8B1D1D" />
            <Setter Property="Foreground" Value="#FFE2E2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A1F1F" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1A1D23" />
            <Setter Property="BorderBrush" Value="#2E323A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <ContentPresenter />
                            <Border Height="3"
                                    VerticalAlignment="Bottom"
                                    Background="#2563EB"
                                    CornerRadius="6,6,0,0"
                                    Visibility="Collapsed"
                                    x:Name="Indicator" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SubtleHoverBlueText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SubtleHoverBlueBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleHoverBlueText}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBlue}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemActionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SubtleHoverBlueBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBlue}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#1A1D23" />
        <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#1A1D23" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E323A" />
        <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#2E323A" />
        <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ComboBoxArrowBrush" Color="#BFBFBF" />
        <SolidColorBrush x:Key="ComboBoxArrowHoverBrush" Color="#FFFFFF" />

        <Style x:Key="DarkComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{StaticResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                <Border Grid.Column="1" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1,0,0,0">
                                    <Path x:Name="Arrow"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource ComboBoxArrowBrush}"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ComboBoxArrowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ComboBoxPopupBackgroundBrush}" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource ComboBoxItemHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource ComboBoxItemSelectedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Background" Value="{StaticResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource DarkComboBoxToggleButtonStyle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,2,30,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource ComboBoxPopupBackgroundBrush}" BorderBrush="{StaticResource ComboBoxBorderBrush}" BorderThickness="1" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSettingCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Root"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="#1A1D23"
                                BorderBrush="#2E323A"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Path x:Name="CheckGlyph"
                                  Data="M 4 11 L 9 15 L 17 6"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBlueBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SubtleHoverBlueBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipboardItemTemplate" DataType="{x:Type vm:ClipboardItemViewModel}">
            <Border x:Name="Card"
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="#1A1D23"
                    BorderBrush="#2E323A"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconLucide Grid.Column="0"
                                                  Kind="{Binding Type, Converter={StaticResource ClipboardTypeToIconKindConverter}}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="#6B7280"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Top" />

                        <Grid Grid.Column="1">
                            <StackPanel x:Name="LockedPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock Text="************"
                                           Foreground="#FFFFFF"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           Margin="0,0,8,0" />
                                <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="Locked Vault Item" FontSize="10" Foreground="#9CA3AF" />
                                </Border>
                            </StackPanel>

                            <Border x:Name="ImagePanel"
                                    Width="96"
                                    Height="64"
                                    Background="#1F2937"
                                    BorderBrush="#2E323A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Image x:Name="ImagePreview"
                                           Source="{Binding ImagePath}"
                                           Stretch="UniformToFill" />
                                    <iconPacks:PackIconLucide x:Name="ImagePlaceholder"
                                                              Kind="Image"
                                                              Width="20"
                                                              Height="20"
                                                              Foreground="#6B7280"
                                                              Visibility="Collapsed"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PreviewText}"
                                           Foreground="#9CA3AF"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxHeight="32"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RelativeTime}" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Background="#1A365D"
                                    CornerRadius="6"
                                    Padding="5,1"
                                    Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{Binding CategoryDisplayName}" Foreground="#8EC5FF" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ActionButtons"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Background="#1A1D23">
                            <Button Style="{StaticResource ItemActionIconButtonStyle}"
                                    Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" Foreground="#A4A4A4" />
                            </Button>
                            <Button Style="{StaticResource ItemActionIconButtonStyle}"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <iconPacks:PackIconLucide Kind="Star" Width="14" Height="14">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Foreground" Value="#A4A4A4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="#FACC15" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                            <Button Style="{StaticResource ItemActionIconButtonStyle}"
                                    Command="{Binding DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <iconPacks:PackIconLucide Width="14" Height="14" Foreground="#60A5FA">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind" Value="Lock" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Kind" Value="LockOpen" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                            <Button Style="{StaticResource ItemActionIconButtonStyle}"
                                    Command="{Binding DataContext.OpenEditItemModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <iconPacks:PackIconLucide Kind="Pencil" Width="14" Height="14" Foreground="#A4A4A4" />
                            </Button>
                            <Button Style="{StaticResource ItemActionIconButtonStyle}"
                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="#F87171" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#1A1D23" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#374151" />
                    <Setter TargetName="ActionButtons" Property="Opacity" Value="1" />
                    <Setter TargetName="ActionButtons" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="LockedPanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ImagePanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TextPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLocked}" Value="False" />
                        <Condition Binding="{Binding Type}" Value="Image" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ImagePanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TextPanel" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                    <Setter TargetName="ImagePlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImagePath}" Value="">
                    <Setter TargetName="ImagePlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                    <Setter TargetName="ImagePreview" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImagePath}" Value="">
                    <Setter TargetName="ImagePreview" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLocked}" Value="False" />
                        <Condition Binding="{Binding Type}" Value="Text" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TextPanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ImagePanel" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#0F1115"
            BorderBrush="#2E323A"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F1115" BorderBrush="#2E323A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,6,0" ClipToBounds="True" BorderBrush="#2E323A" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/Clipboard2.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="ClipVault" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_OnClick">
                            <iconPacks:PackIconLucide Kind="Minus" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_OnClick">
                            <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="14,12,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" Foreground="#6B7280" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         x:Name="SearchTextBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="White"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Padding="8,8"
                                         CaretBrush="White"
                                         MaxLength="300"
                                         TextWrapping="NoWrap"
                                         SpellCheck.IsEnabled="False" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                     <Border Background="#1F2937" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="6" Padding="4,1" Margin="0,0,4,0">
                                        <TextBlock Text="Ctrl" Foreground="#9CA3AF" FontSize="9" FontFamily="Consolas" />
                                    </Border>
                                     <Border Background="#1F2937" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="6" Padding="4,1">
                                        <TextBlock Text="F" Foreground="#9CA3AF" FontSize="9" FontFamily="Consolas" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="14,12,14,0" BorderBrush="#2E323A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource TabButtonStyle}"
                                      Content="Recent"
                                      IsChecked="{Binding ActiveTab, Converter={StaticResource TabMatchToBooleanConverter}, ConverterParameter=Recent}"
                                      Command="{Binding SelectTabCommand}"
                                      CommandParameter="{x:Static vm:NavigationTab.Recent}" />
                        <ToggleButton Style="{StaticResource TabButtonStyle}"
                                      Content="Favorites"
                                      IsChecked="{Binding ActiveTab, Converter={StaticResource TabMatchToBooleanConverter}, ConverterParameter=Favorites}"
                                      Command="{Binding SelectTabCommand}"
                                      CommandParameter="{x:Static vm:NavigationTab.Favorites}" />
                        <ToggleButton Style="{StaticResource TabButtonStyle}"
                                      Content="Categories"
                                      IsChecked="{Binding ActiveTab, Converter={StaticResource TabMatchToBooleanConverter}, ConverterParameter=Categories}"
                                      Command="{Binding SelectTabCommand}"
                                      CommandParameter="{x:Static vm:NavigationTab.Categories}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,8">
                        <Button Margin="0,0,6,0"
                                Padding="8,2"
                                BorderThickness="1"
                                Command="{Binding ToggleCategoryManagerCommand}"
                                Visibility="{Binding IsCategoryTab, Converter={StaticResource BoolToVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBlue}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource HoverBlue}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PressedBlue}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCategoryManagerOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PressedBlue}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PressedBlue}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="SlidersHorizontal" Width="13" Height="13" Margin="0,0,5,0"/>
                                <TextBlock Text="Manage" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Width="24" Height="24" Margin="0,0,4,0" Style="{StaticResource TopBarIconButtonStyle}" Command="{Binding OpenAddModalCommand}">
                            <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                        <Button Width="24" Height="24" Style="{StaticResource TopBarIconButtonStyle}" Command="{Binding ToggleSettingsCommand}">
                            <iconPacks:PackIconLucide Kind="Settings" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="10,8,10,6">
                <Grid.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </Grid.Resources>

                <ListBox ItemsSource="{Binding VisibleItems}"
                         ItemTemplate="{StaticResource ClipboardItemTemplate}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding IsFlatListTab, Converter={StaticResource BoolToVisibility}}" />

                <Grid Visibility="{Binding IsCategoryTab, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10"
                            Panel.ZIndex="5"
                            Visibility="{Binding IsCategoryManagerOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Category Manager" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1A1D23" Foreground="White" BorderBrush="#2E323A" Padding="8,5"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Add" Command="{Binding CreateCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="10,5"/>
                            </Grid>
                            <ListBox Height="100"
                                     ItemsSource="{Binding Categories}"
                                     SelectedItem="{Binding SelectedCategory}"
                                     DisplayMemberPath="Name"
                                     Background="#1A1D23"
                                     Foreground="#9CA3AF"
                                     BorderBrush="#2E323A">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1F2937" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1F2937" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RenameCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1A1D23" Foreground="White" BorderBrush="#2E323A" Padding="8,5"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Rename" Command="{Binding RenameSelectedCategoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="10,5"/>
                                <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteSelectedCategoryCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Padding="10,5"/>
                            </Grid>
                            <TextBlock Text="{Binding CategoryStatusMessage}" Foreground="#FCA5A5" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Background="#1F2937"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCategoryManagerOpen}" Value="False"/>
                                            <Condition Binding="{Binding Categories.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No categories yet. Click Manage to create one."
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CategoryGroups}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryGroupViewModel}">
                                <Border Margin="0,0,0,8" Background="Transparent">
                                    <Expander IsExpanded="{Binding IsExpanded}" Background="#1F2937" BorderBrush="#2E323A" BorderThickness="1" Padding="4">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide Kind="Folder" Width="14" Height="14" Foreground="#60A5FA" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                                <Border Grid.Column="2" Background="#1A1D23" CornerRadius="9" Padding="6,1">
                                                    <TextBlock Text="{Binding Items.Count}" Foreground="#9CA3AF" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ClipboardItemTemplate}" Margin="4,6,0,0" />
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="{Binding HasVisibleItems, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCategoryManagerOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Search" Width="30" Height="30" Foreground="#6B7280" HorizontalAlignment="Center" />
                        <TextBlock Text="No items found" Foreground="#6B7280" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="4" Background="#0F1115" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="8,0">
                <TextBlock Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Use Up/Down to navigate, Enter to paste" />
            </Border>

            <Border Grid.Row="1"
                    Grid.RowSpan="4"
                    Background="#0F1115"
                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="28" Height="28" Margin="0,0,8,0" Style="{StaticResource TopBarIconButtonStyle}"
                                    Command="{Binding ToggleSettingsCommand}">
                                <iconPacks:PackIconLucide Kind="ArrowLeft" Width="16" Height="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                            <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,12,12,12">
                        <StackPanel>
                            <TextBlock Text="General" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                            <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Keyboard" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Global Hotkey" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Shortcut to open ClipVault" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GlobalHotkeyDisplay}" Foreground="#CFCFCF" FontFamily="Consolas" FontSize="12" />
                                            </Border>
                                            <Button Content="Change"
                                                    Command="{Binding OpenHotkeyModalCommand}"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Monitor" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Run at Windows startup" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Launch silently in system tray" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                                  Style="{StaticResource DarkSettingCheckboxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Data and Capture" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                            <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Copy" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Ignore duplicates" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Do not save repeated items" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IgnoreDuplicates, Mode=TwoWay}"
                                                  Style="{StaticResource DarkSettingCheckboxStyle}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="List" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Recent items shown" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="How many items appear in Recent tab" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="110"
                                                  ItemsSource="{Binding RecentItemsLimitOptions}"
                                                  SelectedItem="{Binding RecentItemsLimit}"
                                                  IsEditable="False"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectionChanged="RecentItemsLimitComboBox_OnSelectionChanged" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Database" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Retention limit" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Maximum items to keep" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="110"
                                                  ItemsSource="{Binding RetentionOptions}"
                                                  SelectedItem="{Binding RetentionLimit}"
                                                  IsEditable="False"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectionChanged="RetentionLimitComboBox_OnSelectionChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Vault Security" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                            <Border Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Shield" Width="16" Height="16" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="Auto-lock timeout (mins)" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Require PIN after inactivity" Foreground="#9CA3AF" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Width="110"
                                                  ItemsSource="{Binding AutoLockTimeoutOptions}"
                                                  SelectedItem="{Binding AutoLockTimeout}"
                                                  IsEditable="False"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectionChanged="AutoLockTimeoutComboBox_OnSelectionChanged" />
                                    </Grid>

                                    <TextBlock Text="Set or Change Vault PIN" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Margin="0,0,6,0"
                                                 Text="{Binding PinSetup, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1A1D23"
                                                 BorderBrush="#2E323A"
                                                 Foreground="White"
                                                 Padding="8,6"
                                                 VerticalContentAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Margin="6,0,0,0"
                                                 Text="{Binding PinConfirm, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1A1D23"
                                                 BorderBrush="#2E323A"
                                                 Foreground="White"
                                                 Padding="8,6"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Button Content="Save PIN"
                                            Command="{Binding SavePinCommand}"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6"
                                            Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding PinStatus}" Foreground="#8BC34A" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Button Content="Clear Clipboard History"
                                    Command="{Binding OpenClearHistoryModalCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,8"
                                    FontWeight="SemiBold" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Hotkey Recording Modal -->
            <Border Grid.RowSpan="5"
                    Background="#99000000"
                    Visibility="{Binding IsHotkeyModalOpen, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="50">
                <Grid>
                    <Border Width="360"
                            Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="14,12">
                                <TextBlock Text="Set Global Hotkey"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                            </Border>

                            <StackPanel Grid.Row="1" Margin="14,16,14,16" HorizontalAlignment="Center">
                                <TextBlock Text="Press your desired key combination"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                                <Border Background="#0F1115"
                                        BorderBrush="#2563EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        MinWidth="200"
                                        HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding RecordedHotkeyDisplay}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecordedHotkeyDisplay}" Value="">
                                                        <Setter Property="Text" Value="Press keys..." />
                                                        <Setter Property="Foreground" Value="#6B7280" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="Use Ctrl, Alt or Shift with another key"
                                           Foreground="#6B7280"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelHotkeyCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save"
                                            Command="{Binding ConfirmHotkeyCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,6"
                                            IsEnabled="{Binding CanConfirmHotkey}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.RowSpan="5"
                    Background="#99000000"
                    Visibility="{Binding IsClearHistoryModalOpen, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="38">
                <Grid>
                    <Border Width="360"
                            Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="14,12">
                                <TextBlock Text="Clear Clipboard History"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                            </Border>

                            <StackPanel Grid.Row="1" Margin="14,12,14,12">
                                <TextBlock Text="{Binding ClearHistoryMessage}"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <RadioButton GroupName="ClearScope"
                                             Content="Clear Recent (visible now)"
                                             Foreground="#9CA3AF"
                                             IsChecked="True"
                                             Command="{Binding SetClearHistoryScopeCommand}"
                                             CommandParameter="RecentVisible"
                                             Margin="0,0,0,6" />
                                <RadioButton GroupName="ClearScope"
                                             Content="Clear Favorites"
                                             Foreground="#9CA3AF"
                                             Command="{Binding SetClearHistoryScopeCommand}"
                                             CommandParameter="Favorites"
                                             Margin="0,0,0,6" />
                                <RadioButton GroupName="ClearScope"
                                             Content="Clear All"
                                             Foreground="#9CA3AF"
                                             Command="{Binding SetClearHistoryScopeCommand}"
                                             CommandParameter="All" />
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelClearHistoryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Padding="12,5" />
                                    <Button Content="Confirm"
                                            Command="{Binding ConfirmClearHistoryCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="12,5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.RowSpan="5"
                    Background="#99000000"
                    Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="30">
                <Grid>
                    <Border Width="340"
                            Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" Foreground="#2563EB" Margin="0,0,8,0" />
                                        <TextBlock Text="Add Item Manually" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0"
                                            Command="{Binding CloseAddModalCommand}">
                                        <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="14,12,14,12">
                                <TextBlock Text="Title (optional)" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1A1D23"
                                         Foreground="White"
                                         BorderBrush="#2E323A"
                                         Padding="8"
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Content" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewItemContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="90"
                                         Background="#1A1D23"
                                         Foreground="White"
                                         BorderBrush="#2E323A"
                                         Padding="8"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Category" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding CategoryChoices}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding NewItemCategoryId}"
                                          IsEditable="False"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0,0,0,10" />

                                <WrapPanel>
                                    <CheckBox Content="Save as Favorite"
                                              IsChecked="{Binding NewItemIsFavorite}"
                                              Foreground="#9CA3AF"
                                              Margin="0,0,14,0" />
                                    <CheckBox Content="Lock in Vault"
                                              IsChecked="{Binding NewItemIsLocked}"
                                              Foreground="#9CA3AF" />
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CloseAddModalCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Padding="12,5" />
                                    <Button Content="Add Item"
                                            Command="{Binding AddManualItemCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.RowSpan="5"
                    Background="#99000000"
                    Visibility="{Binding IsEditItemModalOpen, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="35">
                <Grid>
                    <Border Width="340"
                            Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="14,12">
                                <TextBlock Text="Edit Item" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="14,12,14,12">
                                <TextBlock Text="Title" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditItemTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1A1D23" Foreground="White" BorderBrush="#2E323A" Padding="8" Margin="0,0,0,10"/>
                                <TextBlock Text="Category" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CategoryChoices}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding EditItemCategoryId}"
                                          IsEditable="False"
                                          Style="{StaticResource DarkComboBoxStyle}" />
                            </StackPanel>
                            <Border Grid.Row="2" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Command="{Binding CloseEditItemModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,5"/>
                                    <Button Content="Save" Command="{Binding UpdateItemMetadataCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.RowSpan="5"
                    Background="#99000000"
                    Visibility="{Binding IsUnlockModalOpen, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="40">
                <Grid>
                    <Border Width="320"
                            Background="#1A1D23"
                            BorderBrush="#2E323A"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#2E323A" BorderThickness="0,0,0,1" Padding="14,12">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Shield" Width="16" Height="16" Foreground="#2563EB" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding UnlockModalTitle}" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="14,12,14,12">
                                <TextBlock Text="Enter your PIN to continue." Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,8" />
                                <TextBox Text="{Binding UnlockPin, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1A1D23"
                                         Foreground="White"
                                         BorderBrush="#2E323A"
                                         FontSize="16"
                                         FontFamily="Consolas"
                                         HorizontalContentAlignment="Center"
                                         Padding="8"
                                         MaxLength="32" />
                                <TextBlock Text="{Binding UnlockError}" Foreground="#F87171" FontSize="11" Margin="0,8,0,0" />
                                <TextBlock Text="PIN verified. Processing..."
                                           Foreground="#8BC34A"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding UnlockSuccess, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1A1D23" BorderBrush="#2E323A" BorderThickness="0,1,0,0" Padding="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelUnlockCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Padding="12,5" />
                                    <Button Content="Unlock"
                                            Command="{Binding SubmitUnlockCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
